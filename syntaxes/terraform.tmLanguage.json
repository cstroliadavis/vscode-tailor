{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Terraform",
  "patterns": [
    { "include": "#comment" },
    { "include": "#heredoc" },
    { "include": "#blockDeclaration" },
    { "include": "#nestedBlock" },
    { "include": "#attribute" },
    { "include": "#value" }
  ],
  "repository": {
    "attribute": {
      "captures": {
        "1": { "name": "variable.other.member.terraform" },
        "2": { "name": "keyword.operator.assignment.terraform" }
      },
      "match": "^\\s*([A-Za-z0-9_-]+|\"(?:\\\\.|[^\"\\\\])*\")\\s*(=)(?!=)"
    },
    "blockDeclaration": {
      "captures": {
        "1": { "name": "keyword.control.block.terraform" },
        "2": { "name": "entity.name.type.terraform" },
        "3": { "name": "entity.name.function.terraform" }
      },
      "match": "^\\s*\\b(terraform|provider|resource|data|variable|output|locals|module|moved|import|check)\\b(?:\\s+(\"[^\"]*\"|[A-Za-z0-9_-]+))?(?:\\s+(\"[^\"]*\"|[A-Za-z0-9_-]+))?(?=\\s*\\{)"
    },
    "boolean": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean.terraform"
    },
    "builtinType": {
      "match": "\\b(string|number|bool|list|set|map|object|tuple|any)\\b",
      "name": "storage.type.terraform"
    },
    "comment": {
      "patterns": [
        {
          "match": "(?:#|//).*$",
          "name": "comment.line.terraform"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.terraform"
        }
      ]
    },
    "functionCall": {
      "captures": {
        "1": { "name": "support.function.builtin.terraform" }
      },
      "match": "\\b([A-Za-z_][A-Za-z0-9_-]*)\\s*(?=\\()"
    },
    "heredoc": {
      "begin": "(<<-?)([A-Za-z0-9_]+)",
      "beginCaptures": {
        "1": { "name": "keyword.operator.heredoc.terraform" },
        "2": { "name": "keyword.control.heredoc-token.terraform" }
      },
      "end": "^\\s*(\\2)\\s*$",
      "endCaptures": {
        "1": { "name": "keyword.control.heredoc-token.terraform" }
      },
      "name": "string.unquoted.heredoc.terraform"
    },
    "nestedBlock": {
      "captures": {
        "1": { "name": "entity.name.section.block.terraform" },
        "2": { "name": "string.quoted.double.terraform" }
      },
      "match": "^\\s*([A-Za-z_][A-Za-z0-9_-]*)(?:\\s+(\"[^\"]*\"))?(?=\\s*\\{)"
    },
    "nullLiteral": {
      "match": "\\b(null)\\b",
      "name": "constant.language.null.terraform"
    },
    "number": {
      "match": "(?<![\\w.])(?:-?(?:0x[0-9A-Fa-f]+|\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?))(?![\\w.])",
      "name": "constant.numeric.terraform"
    },
    "reference": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_*-]+)+)\\b",
      "name": "variable.other.property.terraform"
    },
    "string": {
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.terraform" }
      },
      "end": "\"",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.terraform" }
      },
      "name": "string.quoted.double.terraform",
      "patterns": [
        {
          "match": "\\\\(?:[btnfr\"\\\\/]|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})",
          "name": "constant.character.escape.terraform"
        },
        {
          "begin": "\\$\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.section.interpolation.begin.terraform" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.interpolation.end.terraform" }
          },
          "name": "meta.interpolation.terraform",
          "patterns": [{ "include": "#value" }]
        }
      ]
    },
    "value": {
      "patterns": [
        { "include": "#string" },
        { "include": "#boolean" },
        { "include": "#nullLiteral" },
        { "include": "#builtinType" },
        { "include": "#number" },
        { "include": "#functionCall" },
        { "include": "#reference" }
      ]
    }
  },
  "scopeName": "source.terraform"
}
