{
  "autoClosingPairs": [
    { "close": "}", "open": "{" },
    { "close": "]", "open": "[" },
    { "close": ")", "open": "(" },
    { "close": "\"", "notIn": ["string"], "open": "\"" },
    { "close": "*/", "notIn": ["string"], "open": "/*" }
  ],
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "comments": {
    "blockComment": ["/*", "*/"],
    "lineComment": "#"
  },
  "folding": {
    "markers": {
      "end": "^\\s*#\\s*endregion\\b",
      "start": "^\\s*#\\s*region\\b"
    }
  },
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ]
}
