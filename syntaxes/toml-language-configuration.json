{
  "autoClosingPairs": [
    { "close": "}", "open": "{" },
    { "close": "]", "open": "[" },
    { "close": ")", "open": "(" },
    { "close": "\"", "notIn": ["string"], "open": "\"" },
    { "close": "'", "notIn": ["string", "comment"], "open": "'" },
    { "close": "\"\"\"", "notIn": ["string", "comment"], "open": "\"\"\"" },
    { "close": "'''", "notIn": ["string", "comment"], "open": "'''" }
  ],
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "comments": {
    "lineComment": "#"
  },
  "folding": {
    "markers": {
      "end": "^\\s*#\\s*endregion\\b",
      "start": "^\\s*#\\s*region\\b"
    },
    "offSide": true
  },
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ]
}
