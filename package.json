{
  "name": "vscode-tailor",
  "displayName": "VS Code Tailor",
  "description": "Personal, modular VS Code workbench extension with an AG Grid-style CSV Editor, Rainbow CSV text highlighting, an interactive HTTP/REST Client Workbench (.http / .rest), TOML/JSON/YAML syntax highlighting, and context-menu Text/HTTP Utilities.",
  "version": "0.5.1",
  "publisher": "chris-strolia-davis",
  "license": "MIT",
  "author": "Chris Strolia-Davis <christopher.stroliadavis@gmail.com>",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Formatters",
    "Visualization",
    "Testing"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "languages": [
      {
        "id": "http",
        "aliases": [
          "HTTP",
          "REST",
          "http"
        ],
        "extensions": [
          ".http",
          ".rest"
        ]
      },
      {
        "id": "toml",
        "aliases": [
          "TOML",
          "toml"
        ],
        "extensions": [
          ".toml",
          ".tml"
        ],
        "configuration": "./syntaxes/toml-language-configuration.json"
      },
      {
        "id": "yaml",
        "aliases": [
          "YAML",
          "yaml",
          "YML",
          "yml"
        ],
        "extensions": [
          ".yaml",
          ".yml"
        ],
        "configuration": "./syntaxes/yaml-language-configuration.json"
      },
      {
        "id": "json",
        "aliases": [
          "JSON",
          "json"
        ],
        "extensions": [
          ".json"
        ],
        "configuration": "./syntaxes/json-language-configuration.json"
      },
      {
        "id": "jsonc",
        "aliases": [
          "JSON with Comments",
          "jsonc"
        ],
        "extensions": [
          ".jsonc"
        ],
        "configuration": "./syntaxes/json-language-configuration.json"
      },
      {
        "id": "jsonl",
        "aliases": [
          "JSON Lines",
          "jsonl",
          "ndjson"
        ],
        "extensions": [
          ".jsonl",
          ".ndjson"
        ],
        "configuration": "./syntaxes/json-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "http",
        "scopeName": "source.http",
        "path": "./syntaxes/http.tmLanguage.json"
      },
      {
        "language": "toml",
        "scopeName": "source.toml",
        "path": "./syntaxes/toml.tmLanguage.json"
      },
      {
        "language": "yaml",
        "scopeName": "source.yaml",
        "path": "./syntaxes/yaml.tmLanguage.json"
      },
      {
        "language": "json",
        "scopeName": "source.json",
        "path": "./syntaxes/json.tmLanguage.json"
      },
      {
        "language": "jsonc",
        "scopeName": "source.json",
        "path": "./syntaxes/json.tmLanguage.json"
      },
      {
        "language": "jsonl",
        "scopeName": "source.json",
        "path": "./syntaxes/json.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "vscodeTailor.toggleFeatures",
        "title": "Toggle Feature Modules",
        "category": "Tailor"
      },
      {
        "command": "vscodeTailor.csv.switchToText",
        "title": "Switch to Text View",
        "category": "Tailor CSV",
        "icon": "$(code)"
      },
      {
        "command": "vscodeTailor.csv.switchToGrid",
        "title": "Switch to Grid View",
        "category": "Tailor CSV",
        "icon": "$(table)"
      },
      {
        "command": "vscodeTailor.http.switchToText",
        "title": "Switch to Text View",
        "category": "Tailor HTTP",
        "icon": "$(code)"
      },
      {
        "command": "vscodeTailor.http.switchToGui",
        "title": "Switch to GUI Workbench",
        "category": "Tailor HTTP",
        "icon": "$(globe)"
      },
      {
        "command": "vscodeTailor.http.runSingleRequest",
        "title": "Run HTTP Request",
        "category": "Tailor HTTP",
        "icon": "$(play)"
      },
      {
        "command": "vscodeTailor.http.runAllInFile",
        "title": "Run All HTTP Requests in File",
        "category": "Tailor HTTP",
        "icon": "$(run-all)"
      },
      {
        "command": "vscodeTailor.http.selectEnvironment",
        "title": "Select HTTP Environment",
        "category": "Tailor HTTP",
        "icon": "$(server-environment)"
      },
      {
        "command": "vscodeTailor.http.setSecret",
        "title": "Set Secret Value (SecretStorage)",
        "category": "Tailor HTTP",
        "icon": "$(key)"
      },
      {
        "command": "vscodeTailor.utils.sortSmart",
        "title": "Smart Sort (Array / Object / Params / List)",
        "category": "Tailor Utils"
      },
      {
        "command": "vscodeTailor.utils.sortLinesAsc",
        "title": "Sort Rows Ascending",
        "category": "Tailor Utils"
      },
      {
        "command": "vscodeTailor.utils.sortLinesDesc",
        "title": "Sort Rows Descending",
        "category": "Tailor Utils"
      },
      {
        "command": "vscodeTailor.utils.sortImports",
        "title": "Sort Imports",
        "category": "Tailor Utils"
      },
      {
        "command": "vscodeTailor.utils.base64Toggle",
        "title": "Base64 Encode / Decode",
        "category": "Tailor Utils"
      },
      {
        "command": "vscodeTailor.utils.urlToggle",
        "title": "URL Encode / Decode",
        "category": "Tailor Utils"
      },
      {
        "command": "vscodeTailor.utils.htmlToggle",
        "title": "HTML Encode / Decode",
        "category": "Tailor Utils"
      },
      {
        "command": "vscodeTailor.utils.httpToCurl",
        "title": "Convert to cURL",
        "category": "Tailor Utils"
      },
      {
        "command": "vscodeTailor.utils.httpToFetch",
        "title": "Convert to fetch()",
        "category": "Tailor Utils"
      },
      {
        "command": "vscodeTailor.utils.httpToHttpFile",
        "title": "Convert to .http Request",
        "category": "Tailor Utils"
      },
      {
        "command": "vscodeTailor.utils.caseSnake",
        "title": "Case: snake_case",
        "category": "Tailor Utils"
      },
      {
        "command": "vscodeTailor.utils.caseUpperSnake",
        "title": "Case: UPPER_SNAKE_CASE",
        "category": "Tailor Utils"
      },
      {
        "command": "vscodeTailor.utils.caseKebab",
        "title": "Case: kebab-case",
        "category": "Tailor Utils"
      },
      {
        "command": "vscodeTailor.utils.caseUpperKebab",
        "title": "Case: UPPER-KEBAB-CASE",
        "category": "Tailor Utils"
      },
      {
        "command": "vscodeTailor.utils.casePascal",
        "title": "Case: PascalCase",
        "category": "Tailor Utils"
      },
      {
        "command": "vscodeTailor.utils.caseCamel",
        "title": "Case: camelCase",
        "category": "Tailor Utils"
      },
      {
        "command": "vscodeTailor.utils.caseTitle",
        "title": "Case: Title Case",
        "category": "Tailor Utils"
      },
      {
        "command": "vscodeTailor.utils.caseUpper",
        "title": "Case: UPPER CASE",
        "category": "Tailor Utils"
      },
      {
        "command": "vscodeTailor.utils.caseLower",
        "title": "Case: lower case",
        "category": "Tailor Utils"
      }
    ],
    "submenus": [
      {
        "id": "vscodeTailor.utilsMenu",
        "label": "Utils"
      }
    ],
    "customEditors": [
      {
        "viewType": "vscodeTailor.csvGrid",
        "displayName": "Tailor CSV Grid",
        "selector": [
          {
            "filenamePattern": "*.csv"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "vscodeTailor.httpWorkbench",
        "displayName": "Tailor HTTP Workbench",
        "selector": [
          {
            "filenamePattern": "*.http"
          },
          {
            "filenamePattern": "*.rest"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vscodeTailor.csv.switchToText",
          "when": "activeCustomEditorId == 'vscodeTailor.csvGrid'",
          "group": "navigation@1"
        },
        {
          "command": "vscodeTailor.csv.switchToGrid",
          "when": "resourceExtname == '.csv' && activeCustomEditorId != 'vscodeTailor.csvGrid'",
          "group": "navigation@1"
        },
        {
          "command": "vscodeTailor.http.switchToText",
          "when": "activeCustomEditorId == 'vscodeTailor.httpWorkbench'",
          "group": "navigation@1"
        },
        {
          "command": "vscodeTailor.http.switchToGui",
          "when": "(resourceExtname == '.http' || resourceExtname == '.rest') && activeCustomEditorId != 'vscodeTailor.httpWorkbench'",
          "group": "navigation@1"
        },
        {
          "command": "vscodeTailor.http.runAllInFile",
          "when": "resourceExtname == '.http' || resourceExtname == '.rest'",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "submenu": "vscodeTailor.utilsMenu",
          "when": "editorTextFocus && config.vscodeTailor.utils.enabled",
          "group": "1_modification@10"
        }
      ],
      "vscodeTailor.utilsMenu": [
        {
          "command": "vscodeTailor.utils.sortSmart",
          "when": "config.vscodeTailor.utils.sort.enabled",
          "group": "1_sort@1"
        },
        {
          "command": "vscodeTailor.utils.sortLinesAsc",
          "when": "config.vscodeTailor.utils.sort.enabled",
          "group": "1_sort@2"
        },
        {
          "command": "vscodeTailor.utils.sortLinesDesc",
          "when": "config.vscodeTailor.utils.sort.enabled",
          "group": "1_sort@3"
        },
        {
          "command": "vscodeTailor.utils.sortImports",
          "when": "config.vscodeTailor.utils.sort.enabled",
          "group": "1_sort@4"
        },
        {
          "command": "vscodeTailor.utils.base64Toggle",
          "when": "config.vscodeTailor.utils.encode.enabled",
          "group": "2_encode@1"
        },
        {
          "command": "vscodeTailor.utils.urlToggle",
          "when": "config.vscodeTailor.utils.encode.enabled",
          "group": "2_encode@2"
        },
        {
          "command": "vscodeTailor.utils.htmlToggle",
          "when": "config.vscodeTailor.utils.encode.enabled",
          "group": "2_encode@3"
        },
        {
          "command": "vscodeTailor.utils.httpToCurl",
          "when": "config.vscodeTailor.utils.http.enabled",
          "group": "3_http@1"
        },
        {
          "command": "vscodeTailor.utils.httpToFetch",
          "when": "config.vscodeTailor.utils.http.enabled",
          "group": "3_http@2"
        },
        {
          "command": "vscodeTailor.utils.httpToHttpFile",
          "when": "config.vscodeTailor.utils.http.enabled",
          "group": "3_http@3"
        },
        {
          "command": "vscodeTailor.utils.caseSnake",
          "when": "config.vscodeTailor.utils.case.enabled",
          "group": "4_case@1"
        },
        {
          "command": "vscodeTailor.utils.caseUpperSnake",
          "when": "config.vscodeTailor.utils.case.enabled",
          "group": "4_case@2"
        },
        {
          "command": "vscodeTailor.utils.caseKebab",
          "when": "config.vscodeTailor.utils.case.enabled",
          "group": "4_case@3"
        },
        {
          "command": "vscodeTailor.utils.caseUpperKebab",
          "when": "config.vscodeTailor.utils.case.enabled",
          "group": "4_case@4"
        },
        {
          "command": "vscodeTailor.utils.casePascal",
          "when": "config.vscodeTailor.utils.case.enabled",
          "group": "4_case@5"
        },
        {
          "command": "vscodeTailor.utils.caseCamel",
          "when": "config.vscodeTailor.utils.case.enabled",
          "group": "4_case@6"
        },
        {
          "command": "vscodeTailor.utils.caseTitle",
          "when": "config.vscodeTailor.utils.case.enabled",
          "group": "4_case@7"
        },
        {
          "command": "vscodeTailor.utils.caseUpper",
          "when": "config.vscodeTailor.utils.case.enabled",
          "group": "4_case@8"
        },
        {
          "command": "vscodeTailor.utils.caseLower",
          "when": "config.vscodeTailor.utils.case.enabled",
          "group": "4_case@9"
        }
      ]
    },
    "configuration": {
      "title": "VS Code Tailor",
      "properties": {
        "vscodeTailor.csv.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the CSV Workbench feature module (Interactive Grid View and Rainbow CSV Text Decorator)."
        },
        "vscodeTailor.csv.rainbowEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Rainbow CSV column highlighting and column hover tooltips in the standard Text Editor."
        },
        "vscodeTailor.csv.defaultHeaderRows": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "description": "Default number of top contiguous rows to pin as sticky headers in the CSV Grid View."
        },
        "vscodeTailor.csv.schemas": {
          "type": "object",
          "default": {},
          "description": "Per-file CSV column schema definitions (data types, number decimals, date formats, pinned state, column widths, and header row counts) keyed by workspace-relative file path."
        },
        "vscodeTailor.http.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the HTTP Client Workbench feature module (.http / .rest GUI Custom Editor, CodeLens runner, and secret resolution)."
        },
        "vscodeTailor.http.defaultEnvironment": {
          "type": "string",
          "default": "dev",
          "description": "Default environment name selected from http-client.env.json when opening .http files."
        },
        "vscodeTailor.syntax.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Config Syntax Highlighting feature module for TOML, JSON/JSONC/JSONL, and YAML files."
        },
        "vscodeTailor.syntax.toml.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable TOML syntax highlighting and automatic language detection (.toml, .tml)."
        },
        "vscodeTailor.syntax.json.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable JSON, JSONC, and JSONL syntax highlighting and automatic language detection (.json, .jsonc, .jsonl, .ndjson)."
        },
        "vscodeTailor.syntax.yaml.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable YAML syntax highlighting and automatic language detection (.yaml, .yml)."
        },
        "vscodeTailor.syntax.fileAssociations": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "enum": [
              "toml",
              "yaml",
              "json",
              "jsonc",
              "jsonl"
            ]
          },
          "description": "Custom filename or extension mappings to syntax languages (e.g. { \"Cargo.lock\": \"toml\", \".prettierrc\": \"jsonc\", \".yamllint\": \"yaml\" }) for files whose extension is not .toml, .yaml/.yml, or .json."
        },
        "vscodeTailor.utils.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Text & HTTP Utilities feature module and the editor right-click 'Utils' context menu."
        },
        "vscodeTailor.utils.sort.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show sorting commands (Smart Sort, Sort Rows, Sort Imports) in the Utils context menu."
        },
        "vscodeTailor.utils.encode.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Base64, URL, and HTML encode/decode toggle commands in the Utils context menu."
        },
        "vscodeTailor.utils.http.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show HTTP conversion commands (To cURL, To fetch(), To .http) in the Utils context menu."
        },
        "vscodeTailor.utils.case.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show case conversion commands (snake_case, UPPER_SNAKE, kebab-case, UPPER-KEBAB, etc.) in the Utils context menu."
        }
      }
    }
  },
  "scripts": {
    "build": "bun run build:clean && bun run build:ext && bun run build:webview",
    "build:clean": "rm -rf dist",
    "build:ext": "bun build ./src/extension.ts --outdir ./dist --entry-naming extension.cjs --target node --format cjs --external vscode --sourcemap=external",
    "build:webview": "bun build ./src/features/csv/webview-client.ts --outdir ./dist --entry-naming csv-webview.js --target browser --format iife --sourcemap=external && bun build ./src/features/http/http-webview-client.ts --outdir ./dist --entry-naming http-webview.js --target browser --format iife --sourcemap=external",
    "deploy": "bun run build && bun run scripts/deploy-vsix.ts",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "bun lint",
    "lint:fix": "bun lint --fix",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "bun check"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "latest",
    "@types/vscode": "^1.85.0",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "typescript": "^5.9.3"
  }
}
