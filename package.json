{
  "name": "vscode-tailor",
  "displayName": "VS Code Tailor",
  "description": "Personal, modular VS Code workbench extension with an interactive CSV Grid Editor, Rainbow CSV text highlighting, and toggleable feature modules.",
  "version": "0.1.0",
  "publisher": "chris-strolia-davis",
  "license": "MIT",
  "author": "Chris Strolia-Davis <christopher.stroliadavis@gmail.com>",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Formatters",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "vscodeTailor.toggleFeatures",
        "title": "Toggle Feature Modules",
        "category": "Tailor"
      },
      {
        "command": "vscodeTailor.csv.switchToText",
        "title": "Switch to Text View",
        "category": "Tailor CSV",
        "icon": "$(code)"
      },
      {
        "command": "vscodeTailor.csv.switchToGrid",
        "title": "Switch to Grid View",
        "category": "Tailor CSV",
        "icon": "$(table)"
      }
    ],
    "customEditors": [
      {
        "viewType": "vscodeTailor.csvGrid",
        "displayName": "Tailor CSV Grid",
        "selector": [
          {
            "filenamePattern": "*.csv"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vscodeTailor.csv.switchToText",
          "when": "activeCustomEditorId == 'vscodeTailor.csvGrid'",
          "group": "navigation@1"
        },
        {
          "command": "vscodeTailor.csv.switchToGrid",
          "when": "resourceExtname == '.csv' && activeCustomEditorId != 'vscodeTailor.csvGrid'",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "VS Code Tailor",
      "properties": {
        "vscodeTailor.csv.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the CSV Workbench feature module (Interactive Grid View and Rainbow CSV Text Decorator)."
        },
        "vscodeTailor.csv.rainbowEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Rainbow CSV column highlighting and column hover tooltips in the standard Text Editor."
        },
        "vscodeTailor.csv.defaultHeaderRows": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "description": "Default number of top contiguous rows to pin as sticky headers in the CSV Grid View."
        }
      }
    }
  },
  "scripts": {
    "build": "bun run build:clean && bun run build:ext && bun run build:webview",
    "build:clean": "rm -rf dist",
    "build:ext": "bun build ./src/extension.ts --outdir ./dist --entry-naming extension.cjs --target node --format cjs --external vscode --sourcemap=external",
    "build:webview": "bun build ./src/features/csv/webview-client.ts --outdir ./dist --entry-naming csv-webview.js --target browser --format iife --sourcemap=external",
    "deploy": "bun run build && bun run scripts/deploy-vsix.ts",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "bun lint",
    "lint:fix": "bun lint --fix",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "bun check"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "latest",
    "@types/vscode": "^1.85.0",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "typescript": "^5.9.3"
  }
}
